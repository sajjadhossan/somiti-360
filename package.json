{
  "name": "somiti-360",
  "type": "module",
  "private": true,
  "version": "2.2.0",
  "author": "Somiti 360",
  "description": "সমিতি ৩৬০ - সমিতি, সমবায় সংস্থা ও ক্ষুদ্রঋণ সঞ্চয় ব্যবস্থাপনা প্ল্যাটফর্ম",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/verify_offline_sync.cjs",
    "host": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0 --port 5174",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.15",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "build": {
    "appId": "com.somiti360.desktop",
    "productName": "Somiti 360",
    "electronVersion": "34.0.0",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "public/logo-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "public/logo-512.png",
      "category": "public.app-category.finance",
      "target": [
        "zip",
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "forceCodeSigning": false,
      "identity": null
    },
    "dmg": {
      "sign": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
