# Vercel & Production Environment Variables for Somiti 360
# Never commit .env or secrets to git!

# ==============================================================================
# Dual-Engine Database Architecture (Neon Serverless Postgres + Supabase Realtime)
# ==============================================================================
# 1. Neon Serverless Postgres (Core Financial Ledger, Auto-Scaling & 10,000+ Pooler Connections)
NEON_DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=br-your-branch-id

# Neon Managed Auth (Better Auth)
NEON_AUTH_BASE_URL=https://ep-xyz.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xyz.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
VITE_NEON_AUTH_URL=https://ep-xyz.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth

# Neon Realtime (Live SQL engine)
NEON_REALTIME_URL=wss://ep-xyz.rt.ap-southeast-1.aws.neon.tech/
NEON_REALTIME_SECRET=nrt_live_your_secret
VITE_NEON_REALTIME_URL=wss://ep-xyz.rt.ap-southeast-1.aws.neon.tech/

# Neon Object Storage (S3-Compatible Branching Bucket)
AWS_ACCESS_KEY_ID=nak_live_your_key
AWS_SECRET_ACCESS_KEY=nsk_live_your_secret
AWS_ENDPOINT_URL_S3=https://br-your-branch.storage.ap-southeast-1.aws.neon.tech
AWS_REGION=ap-southeast-1

# 2. Supabase Cloud Gateway (Mobile Auth, Sub-50ms Realtime Mesh & Storage Buckets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API (Backend Only - Never expose in frontend/client)
GEMINI_API_KEY=your-gemini-api-key

# JWT & Authentication
JWT_SECRET=your-jwt-secret-key

# App & Public URLs
VITE_APP_URL=https://somiti360.vercel.app
NEXT_PUBLIC_API_BASE_URL=https://somiti360.vercel.app

# WhatsApp & Omnichannel
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id

# SMS & Telegram (Optional)
SMS_GATEWAY_KEY=your-sms-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
