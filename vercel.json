{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/samity/cloud-state",
      "destination": "/api/samity/cloud-state"
    },
    {
      "source": "/api/app/version",
      "destination": "/api/app/version"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/public/verify",
      "destination": "/api/public/verify"
    },
    {
      "source": "/api/receipts/pdf",
      "destination": "/api/receipts/pdf"
    },
    {
      "source": "/api/receipts/qr",
      "destination": "/api/receipts/qr"
    },
    {
      "source": "/api/sync/pull",
      "destination": "/api/sync/pull"
    },
    {
      "source": "/api/sync/push",
      "destination": "/api/sync/push"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw\\.js|manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|svg|ico|webp|jpg|jpeg|woff|woff2|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
